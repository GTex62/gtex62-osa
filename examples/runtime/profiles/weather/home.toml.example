profile_id = "home"
provider = "openweather"
enabled = true

[location]
name = "home"
lat = 41.8781
lon = -87.6298
timezone = "America/Chicago"

[request]
units = "imperial"
lang = "en"
cache_ttl_sec = 300

[credentials]
owm_api_key = "YOUR_OPENWEATHER_API_KEY"

[events]
cache_ttl_sec = 86400
extra_events_file = "__RUNTIME_ROOT__/state/events_extra.txt"
