profile_id = "home"
baseline_provider = "openweather"
overlay_provider = "airnow"
enabled = true

[location]
lat = 41.8781
lon = -87.6298
timezone = "America/Chicago"

[cache]
ttl_sec = 900

[openweather]
enabled = true
api_key = "YOUR_OPENWEATHER_API_KEY"

[airnow]
enabled = true
api_key = "YOUR_AIRNOW_API_KEY"
distance_miles = 25
window_hours = 6
owm_tolerance_sec = 3600
